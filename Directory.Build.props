<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1062;CA1852;CA1859</NoWarn>

    <!-- Packaging rigor. Pack-time only, so inert for IsPackable=false projects. SourceLink for
         GitHub is implicit in the .NET SDK; ContinuousIntegrationBuild=true is passed by
         publish.yaml, never locally. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- EnablePackageValidation is deliberately absent, not overlooked. It is inert without a
         PackageValidationBaselineVersion, and no reachable feed carries one: NuGet.config maps
         Daml.* to the GitHub Packages feed alone, which stops at 0.1.8-preview.4 and holds five of
         the eight ids packed here, while the published baselines are on nuget.org, which that
         mapping excludes for Daml.*. It goes back on per published project, once Daml.* resolves
         from the feed the baselines are on. -->

    <!-- Package metadata -->
    <Authors>Peaceful Studio OÜ</Authors>
    <Company>Peaceful Studio OÜ</Company>
    <Copyright>Copyright 2026 Peaceful Studio OÜ</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/peacefulstudio/daml-codegen-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/peacefulstudio/daml-codegen-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Versioning -->
    <Version>0.5.0-preview.2</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>

    <!-- Package output directory -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)output/nuget</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
