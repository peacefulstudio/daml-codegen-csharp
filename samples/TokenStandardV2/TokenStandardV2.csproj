<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Offline showcase for the Splice Token Standard V2 C# packages</Description>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Daml.Runtime" Version="0.*-*" />
    <PackageReference Include="Daml.Ledger.Abstractions" Version="0.*-*" />
    <PackageReference Include="Splice.Api.Token.Holding.V2" Version="1.*-*" />
    <PackageReference Include="Splice.Api.Token.Transfer.Instruction.V2" Version="1.*-*" />
    <PackageReference Include="Splice.Api.Token.Transfer.Events.V2" Version="1.*-*" />
    <PackageReference Include="Splice.Api.Token.Allocation.V2" Version="1.*-*" />
    <PackageReference Include="Splice.Api.Token.Allocation.Instruction.V2" Version="1.*-*" />
    <PackageReference Include="Splice.Api.Token.Allocation.Request.V2" Version="1.*-*" />
    <PackageReference Include="Splice.Api.Token.Metadata.V1" Version="1.*-*" />
  </ItemGroup>

</Project>
