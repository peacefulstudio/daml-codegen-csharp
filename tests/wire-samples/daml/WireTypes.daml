module WireTypes where

import DA.Map (Map)
import DA.TextMap (TextMap)

data Profile = Profile
  with
    nickname : Text
    level : Int
  deriving (Eq, Show)

data Outcome = Win with prize : Numeric 2; tier : Text
             | Pending
  deriving (Eq, Show)

data Suit = Clubs | Diamonds | Hearts | Spades
  deriving (Eq, Show)

template Marker
  with
    owner : Party
  where
    signatory owner

data HoldingView = HoldingView
  with
    amount : Decimal
  deriving (Eq, Show)

interface Holding where
  viewtype HoldingView

template Asset
  with
    issuer : Party
    amount : Decimal
  where
    signatory issuer

    interface instance Holding for Asset where
      view = HoldingView with amount

template Keyed
  with
    owner : Party
    label : Text
  where
    signatory owner
    key (owner, label) : (Party, Text)
    maintainer key._1

template WireRecord
  with
    owner : Party
    count : Int
    amount : Numeric 10
    label : Text
    active : Bool
    asOf : Date
    observedAt : Time
    note : Optional Text
    nestedNote : Optional (Optional Text)
    tags : [Text]
    attributes : TextMap Text
    genMap : Map Party Int
    unitField : ()
    marker : ContractId Marker
    holdingCid : ContractId Holding
    holdingCids : [ContractId Holding]
    profile : Profile
    outcome : Outcome
    suit : Suit
    fee : Numeric 2
  where
    signatory owner

    nonconsuming choice Relabel : ContractId WireRecord
      with
        newLabel : Text
      controller owner
      do
        create this with label = newLabel

    nonconsuming choice Describe : Outcome
      with
        probe : Optional Int
      controller owner
      do
        pure outcome

    nonconsuming choice Ping : ()
      controller owner
      do
        pure ()
